# ==============================================================================
# EduAI Backend Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5000

# PostgreSQL Database Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/eduai"

# JWT Secret Key for token signing and verification
JWT_SECRET="replace_with_a_cryptographically_secure_random_string_in_production"

# Default Super Administrator credentials for initialization/seeding
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="ReplaceWithSecureSuperAdminPassword"
