# ==============================================================================
# EduAI Backend Environment Configuration Template
# Production Hosting: Aiven (Backend Service) + Clever Cloud (PostgreSQL DB)
# ==============================================================================

# Server Port (provided by platform / Aiven, defaults to 5000)
PORT=5000
NODE_ENV=production

# Database Connection String
# Production: Clever Cloud PostgreSQL (ONLY approved production database provider)
# Format: postgresql://<user>:<password>@<clever-cloud-host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/eduai"

# JWT Secret Key for cryptographic token signing (64+ chars recommended)
JWT_SECRET="replace_with_a_cryptographically_secure_random_string_in_production"

# Allowed CORS Origins (Set to your Vercel production frontend URL)
# Example: https://eduai-app.vercel.app
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Initial Super Administrator Credentials (used only during initial seed if needed)
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="ReplaceWithSecureSuperAdminPassword"

