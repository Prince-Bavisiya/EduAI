# ==============================================================================
# EduAI Monorepo Environment Configuration Template
# Topology: Frontend (Vercel) -> Backend (Aiven) -> Database (Clever Cloud PostgreSQL)
# ==============================================================================

# -----------------
# Backend Settings (Deployed on Aiven)
# -----------------
PORT=5000
NODE_ENV=production
# Production Database: Clever Cloud PostgreSQL (ONLY approved production database)
# Format: postgresql://<user>:<password>@<clever-cloud-host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/eduai"
JWT_SECRET="replace_with_a_cryptographically_secure_random_string_in_production"
ALLOWED_ORIGINS="http://localhost:3000,https://your-eduai-app.vercel.app"
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="ReplaceWithSecureSuperAdminPassword"

# ------------------
# Frontend Settings (Deployed on Vercel)
# ------------------
# Set on Vercel to point to your Aiven backend API endpoint
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
# Note: DATABASE_URL must NEVER be set on Vercel or in frontend configs.

